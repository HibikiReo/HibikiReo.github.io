---
import { useLocale } from '../i18n';
const { t } = useLocale(Astro.url);
const tabs = [
  { value: 'articles', label: t("文章", "Notes"), path: 'M5 3h14v18H5zM8 7h8M8 11h8M8 15h5' },
  { value: 'works', label: t("作品", "Work"), path: 'M3 7h18v14H3zM8 7V3h8v4M3 12h18M10 12v3h4v-3' },
  { value: 'notes', label: t("手记", "Journal"), path: 'M4 3h15v18H4zM8 3v18M11 8h5M11 12h5' },
];
---
<div class="liquid-preview" data-liquid-preview>
  <canvas class="liquid-scene" aria-hidden="true"></canvas>
  <div class="liquid-heading"><span>Hibiki’s space.</span><span>{t("设计 · 代码 · 日常", "Design · Code · Daily")}</span></div>
  <div class="liquid-copy" id="liquid-content">
    <div class="liquid-panel liquid-articles"><span class="liquid-kicker">{t("交互与设计", "Interaction and design")}</span><h3>{t("我对界面反馈", "Some thoughts on")}<br/>{t("的一些想法。", "interface feedback.")}</h3><p>{t("从按下按钮到切换状态，记下交互里的设计取舍。", "The design choices inside an interaction, from pressing a button to switching state.")}</p></div>
    <div class="liquid-panel liquid-works"><span class="liquid-kicker">{t("浏览器里的作品", "Work in the browser")}</span><h3>{t("我做的一些", "A few small")}<br/>{t("网页小实验。", "web experiments.")}</h3><p>{t("从界面草图到浏览器里的曲线。", "From interface sketches to curves in the browser.")}</p></div>
    <div class="liquid-panel liquid-notes"><span class="liquid-kicker">{t("随手记", "Quick notes")}</span><h3>{t("做界面时，", "What I noted")}<br/>{t("我记了这些。", "while building UI.")}</h3><p>{t("比如怎么安排内容，怎么选材质和反馈。", "How to arrange content, and how to choose materials and feedback.")}</p></div>
  </div>
  <fieldset class="liquid-menu" aria-describedby="liquid-hint">
    <legend class="liquid-sr-only">{t("液态玻璃示例内容", "Liquid glass demo content")}</legend>
    <span class="liquid-selection" aria-hidden="true"></span>
    {tabs.map((tab) => <label><input class="liquid-sr-only" type="radio" name="liquid-content" value={tab.value} checked={tab.value === 'articles'} aria-controls="liquid-content"/><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={tab.path}/></svg><span>{tab.label}</span></label>)}
  </fieldset>
  <span class="liquid-hint" id="liquid-hint">{t("按住菜单左右拖动，或点选栏目。", "Hold the menu and drag sideways, or pick a section.")}</span>
</div>

<script>
  import { initializeLiquidGlass } from '../scripts/liquid-glass';
  document.querySelectorAll<HTMLElement>('[data-liquid-preview]').forEach(initializeLiquidGlass);
</script>

<style>
  .liquid-preview { position: relative; display: flex; flex-direction: column; gap: 1rem; height: 100%; padding: 1.5rem; isolation: isolate; container-type: inline-size; background: radial-gradient(ellipse at 20% 110%, #A6674980, transparent 45%), radial-gradient(ellipse at 90% 100%, #82415070, transparent 45%), var(--theme-bg); font-family: system-ui, "PingFang SC", "Microsoft YaHei", sans-serif; }
  .liquid-scene { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; background: var(--theme-bg); }
  .liquid-heading { display: flex; justify-content: space-between; align-items: center; gap: .75rem; font-size: .75rem; line-height: 1.6; }
  .liquid-heading > span:last-child { font-size: .5625rem; color: var(--theme-muted); }
  .liquid-copy { display: flex; align-items: center; flex: 1; min-height: 0; padding-bottom: 1.25rem; }
  .liquid-kicker { display: block; margin-bottom: .75rem; font-size: .625rem; color: var(--theme-accent); }
  .liquid-copy h3 { margin: 0; font-family: var(--theme-display); font-size: clamp(1.6rem, 5.6cqw, 3.3rem); font-weight: 550; line-height: 1.4; letter-spacing: -.035em; }
  .liquid-copy p { margin: .75rem 0 0; font-size: .75rem; line-height: 1.8; color: var(--theme-muted); overflow-wrap: normal; }
  .liquid-panel { display: none; }
  .liquid-preview:has(input[value="articles"]:checked) .liquid-articles,
  .liquid-preview:has(input[value="works"]:checked) .liquid-works,
  .liquid-preview:has(input[value="notes"]:checked) .liquid-notes { display: block; }
  .liquid-menu { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); flex-shrink: 0; width: min(100%, 29rem); min-width: 0; margin: 0 auto; padding: .4rem; border: 0; border-radius: 999px; background: color-mix(in srgb, var(--theme-surface) 18%, transparent); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); box-shadow: inset 0 1px 0 #ffffffcc, inset 0 -1px 0 #ffffff66, 0 0 0 .5px #00000040, 0 8px 20px #00000012; touch-action: pan-y; user-select: none; }
  .liquid-menu label { position: relative; display: flex; align-items: center; justify-content: center; gap: .45rem; min-height: 2.75rem; border-radius: 999px; color: var(--theme-ink); font-size: .75rem; font-weight: 550; cursor: pointer; }
  .liquid-menu svg { width: 1.05rem; height: 1.05rem; flex-shrink: 0; }
  .liquid-menu label:has(input:checked) { font-weight: 750; }
  .liquid-menu label:has(input:focus-visible) { outline: 2px solid var(--theme-accent); outline-offset: 3px; }
  .liquid-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .liquid-selection { position: absolute; inset-block: .4rem; left: .4rem; width: calc((100% - .8rem) / 3); translate: calc(var(--liquid-position, 0) * 100%) 0; border-radius: 999px; background: color-mix(in srgb, var(--theme-surface) 35%, transparent); pointer-events: none; }
  .liquid-preview:has(input[value="works"]:checked) { --liquid-position: 1; }
  .liquid-preview:has(input[value="notes"]:checked) { --liquid-position: 2; }
  .liquid-preview[data-optics="webgl"] .liquid-menu { background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; }
  .liquid-preview[data-optics="webgl"] .liquid-selection { visibility: hidden; }
  .liquid-hint { position: relative; align-self: center; font-size: .5625rem; line-height: 1.6; color: var(--theme-ink); }
  @container (max-width: 28rem) {
    .liquid-preview { padding: 1.25rem; gap: .85rem; }
    .liquid-heading { font-size: .6875rem; }
    .liquid-heading > span:last-child { display: none; }
    .liquid-copy { padding-bottom: 1rem; }
    .liquid-copy h3 { font-size: 1.8rem; }
    .liquid-copy p { font-size: .6875rem; }
    .liquid-menu label { gap: .3rem; font-size: .6875rem; }
    .liquid-menu svg { width: .9rem; height: .9rem; }
  }
  @container (max-width: 20rem) {
    .liquid-copy h3 { font-size: 1.6rem; }
    .liquid-kicker { margin-bottom: .6rem; }
    .liquid-hint { font-size: .5rem; }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .liquid-preview .liquid-menu { background: var(--theme-surface); -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: 0 0 0 1px var(--theme-ink); }
    .liquid-selection { background: color-mix(in srgb, var(--theme-ink) 12%, var(--theme-surface)); }
  }
</style>
