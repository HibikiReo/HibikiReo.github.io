---
import { useLocale, localePaths } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getArticles } from '../../data/content';
export function getStaticPaths() { return localePaths(); }
const { t, locale } = useLocale(Astro.url);
const articles = getArticles(locale);
const count = (n: number) => t(`${n} 篇`, n === 1 ? '1 note' : `${n} notes`);
// Articles are stored newest first, so the years come out in the same order.
const years = [...new Set(articles.map((article) => article.date.slice(0, 4)))]
  .map((year) => ({ year, items: articles.filter((article) => article.date.startsWith(year)) }));
const pageTitle = t("全部文章", "All notes");
---
<BaseLayout title={`${pageTitle} | ${t("Hibiki 的前端设计与代码笔记", "Hibiki's notes on front-end design and code")}`}>
  <div class="page-progress" aria-hidden="true"></div>
  <SiteHeader current="notes" />
  <main id="main" class="notes-page section-shell">
    <header class="notes-head" id="top">
      <p class="kicker"><span class="small-dot"></span>{t("文章", "Notes")}</p>
      <h1>{pageTitle}</h1>
      <p>{t(`共 ${articles.length} 篇，按时间从新到旧排列。`, `${count(articles.length)}, newest first.`)}</p>
    </header>
    {years.map(({ year, items }) => (
      <section class="note-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year} <small>{count(items.length)}</small></h2>
        <ol class="note-list">{items.map((article) => <ArticleRow article={article} shortDate tags />)}</ol>
      </section>
    ))}
  </main>
  <SiteFooter />
</BaseLayout>
