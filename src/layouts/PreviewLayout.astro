---
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource/instrument-serif/latin-400.css';
import { getSiteStudies, siteStudyArticleHref, type SiteStudyId } from '../data/site-studies';
import { useLocale } from '../i18n';
const { t, href, locale, htmlLang, alternate } = useLocale(Astro.url);
const siteStudies = getSiteStudies(locale);
interface Props { id: SiteStudyId; }
const { id } = Astro.props;
const study = siteStudies.find((item) => item.id === id)!;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={study.description} />
    <meta name="theme-color" content={study.background} />
    <title>{study.brand} · {study.name} | {t('Hibiki 的设计习作', "Hibiki's design studies")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang={t('en', 'zh-CN')} href={alternate} />
    <script is:inline>document.documentElement.classList.add('preview-ready');</script>
  </head>
  <body data-study={id} style={`--preview-bg:${study.background};--preview-ink:${study.ink};--preview-accent:${study.accent}`}>
    <a class="preview-skip" href="#main">{t('跳到预览内容', 'Skip to the preview')}</a>
    <slot />
    <aside class="preview-dock" aria-label={t('设计预览工具栏', 'Preview toolbar')}>
      <a class="preview-back" href={href(siteStudyArticleHref)}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13" /></svg>{t('文章', 'Article')}</a>
      <nav aria-label={t('切换官网风格', 'Switch design')}>{siteStudies.map((item) => <a href={item.href} aria-current={item.id === id ? 'page' : undefined} aria-label={item.name}>{item.shortName}</a>)}</nav>
      <a class="preview-language" href={alternate} hreflang={t('en', 'zh-CN')} lang={t('en', 'zh-CN')}>{t('EN', '中文')}</a>
    </aside>
    <script>import '../scripts/site-previews';</script>
  </body>
</html>

<style is:global>
  :root { font-family: 'DM Sans Variable', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-optical-sizing: auto; font-synthesis: none; font-size: 16px; scroll-behavior: smooth; scroll-padding-top: 5rem; --motion-ease: cubic-bezier(.16, 1, .3, 1); }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; color: var(--preview-ink); background: var(--preview-bg); -webkit-font-smoothing: antialiased; }
  [hidden] { display: none !important; }
  h1, h2, h3, h4, p, figure { margin: 0; }
  button, input, select { font: inherit; }
  a { color: inherit; text-decoration: none; text-underline-offset: .3em; }
  button { color: inherit; cursor: pointer; }
  button, a, summary, label { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  button:disabled { cursor: default; }
  summary { cursor: pointer; }
  img { display: block; max-width: 100%; }
  :is(a, button, input, select, summary, [tabindex]):focus-visible { outline: 2px solid var(--preview-accent); outline-offset: 5px; }
  :is(a, button):active { opacity: .72; }
  h1, h2 { text-wrap: balance; }
  ::selection { background: var(--preview-accent); color: var(--preview-bg); }
  html { scrollbar-color: #777 var(--preview-bg); }
  input { accent-color: var(--preview-accent); caret-color: var(--preview-accent); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .preview-skip { position: absolute; z-index: 100; top: -5rem; left: 1rem; padding: .8rem 1rem; background: #fff; color: #111; }
  .preview-skip:focus { top: .5rem; }
  .preview-dock { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 80; display: flex; align-items: center; gap: .35rem; padding: .3rem; border: 1px solid #ffffff40; border-radius: 999px; background: #f7f7f7f2; color: #303030; box-shadow: 0 6px 28px #0002; backdrop-filter: blur(14px); font-size: .6875rem; }
  .preview-dock a { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-width: 2.75rem; min-height: 2.5rem; padding-inline: .75rem; border-radius: 999px; transition: background .18s; }
  .preview-dock nav { display: flex; gap: .15rem; }
  .preview-dock .preview-back { margin-right: .25rem; }
  .preview-dock .preview-language { margin-left: .25rem; }
  .preview-dock a:hover { background: #e6e6e6; }
  .preview-dock a[aria-current="page"] { background: #252525; color: #fff; }
  .preview-dock a:focus-visible { outline-color: #252525; outline-offset: 1px; }
  .preview-footer { padding-bottom: 6rem !important; }
  /* Entrances: hidden only once the inline head script has confirmed scripting. --i staggers siblings. */
  html.preview-ready [data-reveal] { opacity: 0; transform: translateY(2rem); transition: opacity .9s var(--motion-ease), transform .9s var(--motion-ease), clip-path 1.2s var(--motion-ease); transition-delay: calc(var(--i, 0) * 90ms); }
  html.preview-ready [data-reveal="clip"] { opacity: 1; transform: none; clip-path: inset(0 0 100% 0); }
  html.preview-ready [data-reveal="grow"] { opacity: 1; transform: scaleX(0); transform-origin: left; }
  html.preview-ready [data-reveal].is-in { opacity: 1; transform: none; clip-path: inset(0); }
  [data-loop]:not(.is-playing), [data-loop]:not(.is-playing) * { animation-play-state: paused !important; }
  @media (max-width: 600px) { .preview-dock { right: .75rem; bottom: max(.75rem, env(safe-area-inset-bottom)); } }
  @media (prefers-reduced-transparency: reduce) { .preview-dock { background: #f7f7f7; backdrop-filter: none; } }
  @media (prefers-reduced-motion: reduce) {
    :root { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; transition-delay: 0s !important; }
    html.preview-ready [data-reveal] { opacity: 1; transform: none; clip-path: none; }
  }
</style>
